@* @using importerer de navnerum komponenten har brug for.
   Ingen @rendermode her — komponenten arver static SSR fra Home.razor,
   hvilket betyder data hentes og HTML genereres på serveren uden SignalR. *@
@using BookRight.Facade.DTO
@using BookRight.Facade.Interfaces.Queries

@* @inject henter OccupancyQueries fra dependency injection-containeren. *@
@inject IClinicOccupancyQueries OccupancyQueries

@* <section> er et semantisk HTML5-element der afgrænser et selvstændigt indholdsafsnit.
   aria-label giver sektionen et tilgængeligt navn som skærmlæsere annoncerer. *@
<section aria-label="Klinik belægning i dag" class="mt-4">
    <h3>Belægning i dag</h3>

    @* Indlæsningsindikator — vises mens OnInitializedAsync henter data fra databasen.
       role="status" og aria-live="polite" fortæller skærmlæsere at teksten
       er en statusmeddelelse der opdateres dynamisk. *@
    @if (_loading)
    {
        <p class="text-muted" role="status" aria-live="polite">Indlæser belægning…</p>
    }
    else if (_occupancy.Count == 0)
    {
        <p class="text-muted">Ingen klinikker fundet.</p>
    }
    else
    {
        @* Bootstrap-grid: row-cols-1 giver én kolonne på mobil,
           row-cols-md-2 giver to kolonner på mellemstore skærme og større.
           g-3 er gutter (afstand) mellem kortene. *@
        <div class="row row-cols-1 row-cols-md-2 g-3">
            @foreach (var clinic in _occupancy)
            {
                <div class="col">
                    @* h-100 strækker kortet til fuld højde i sin kolonne
                       så alle kort er lige høje på samme række. *@
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@clinic.Address</h5>

                            @* <dl> (description list) er det semantisk korrekte element til nøgle/værdi-par.
                               <dt> er termen (nøglen), <dd> er definitionen (værdien).
                               Bootstrap's row/col-klasser giver et pænt to-kolonne-layout. *@
                            <dl class="row mb-2">
                                <dt class="col-sm-7">Rum i alt</dt>
                                <dd class="col-sm-5">@clinic.TotalRooms</dd>

                                <dt class="col-sm-7">Aftaler i dag</dt>
                                <dd class="col-sm-5">@clinic.ActiveAppointmentsToday</dd>

                                <dt class="col-sm-7">Peak samtidige rum</dt>
                                <dd class="col-sm-5">@clinic.PeakConcurrentRooms</dd>
                            </dl>

                            @* Belægningsprocenten vises som en Bootstrap progress-bar.
                               role="progressbar" fortæller skærmlæsere at elementet
                               repræsenterer en fremskridtsindikator.
                               aria-valuenow, aria-valuemin og aria-valuemax giver
                               skærmlæsere de nødvendige grænseværdier til at annoncere
                               den aktuelle procent korrekt. *@
                            <div class="d-flex justify-content-between mb-1">
                                <small>Belægning</small>
                                <small>@clinic.OccupancyPercent %</small>
                            </div>
                            <div class="progress" role="progressbar"
                                 aria-valuenow="@clinic.OccupancyPercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-label="Belægning @clinic.OccupancyPercent procent">
                                @* Farven skifter efter belægning: grøn under 60 %, gul 60–90 %, rød 90 %+.
                                   style="width:" sætter søjlens bredde til belægningsprocenten. *@
                                <div class="progress-bar @GetBarColor(clinic.OccupancyPercent)"
                                     style="width: @clinic.OccupancyPercent%">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private IReadOnlyList<ClinicOccupancyDto> _occupancy = [];

    // OnInitializedAsync er en Blazor lifecycle-metode der køres automatisk
    // første gang komponenten indlæses. I static SSR sker dette på serveren
    // og resultatet sendes som færdigt HTML til browseren.
    protected override async Task OnInitializedAsync()
    {
        _occupancy = await OccupancyQueries.GetTodayAsync();
        _loading = false;
    }

    // Returnerer den Bootstrap-baggrundsfarve der passer til belægningsprocenten.
    // Switch-udtryk med >= mønster evaluerer fra top — første match vinder.
    private static string GetBarColor(double pct) => pct switch
    {
        >= 90 => "bg-danger",
        >= 60 => "bg-warning",
        _ => "bg-success"
    };
}
