@page "/opretpatient"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@using BookRight.Blazor.Components.Practitioner
@using BookRight.Domain.Exceptions
@using BookRight.Facade.Command
@using BookRight.Facade.DTO
@using BookRight.Facade.Interfaces.Queries
@using BookRight.Facade.Interfaces.UseCase

@inject IPractitionerQueries PractitionerQueries
@inject ICreatePatientUseCase CreatePatientUseCase

<PageTitle>Opret Patient</PageTitle>

<h2 id="patient-heading">Opret Patient</h2>

@if (_loading)
{
    <p role="status" aria-live="polite" class="text-muted">Indlæser data…</p>
}
else
{
    @* Fejl- og statusbeskeder annonceres automatisk af skærmlæsere via role *@
    <output aria-atomic="true" class="d-block">
        @if (_error is not null)
        {
            <p class="alert alert-danger" role="alert">@_error</p>
        }
        @if (_success)
        {
            <p class="alert alert-success" role="status">Patient oprettet!</p>
        }
    </output>

    @* En lille hjælpetekst øverst der forklarer at * markerer påkrævede felter.
       <span aria-hidden="true"> skjuler stjernen for skærmlæsere, da den
       rent visuelle markering ikke giver mening i lyd. *@
    <p class="text-muted small mb-3">Felter markeret med <span aria-hidden="true">*</span> er påkrævet.</p>

    <form aria-labelledby="patient-heading" novalidate
          @onsubmit="OnSubmit" @onsubmit:preventDefault>

        <label class="form-label" for="firstname">Fornavn <span aria-hidden="true">*</span></label>
        <input id="firstname"
               class="form-control @(_submitted && string.IsNullOrWhiteSpace(_firstName) ? "is-invalid" : "mb-3")"
               type="text"
               @bind="_firstName"
               aria-required="true"
               placeholder="Fornavn" />
        @if (_submitted && string.IsNullOrWhiteSpace(_firstName))
        {
            <small class="invalid-feedback d-block mb-3">Fornavn er påkrævet.</small>
        }

        <label class="form-label" for="lastname">Efternavn <span aria-hidden="true">*</span></label>
        <input id="lastname"
               class="form-control @(_submitted && string.IsNullOrWhiteSpace(_lastName) ? "is-invalid" : "mb-3")"
               type="text"
               @bind="_lastName"
               aria-required="true"
               placeholder="Efternavn" />
        @if (_submitted && string.IsNullOrWhiteSpace(_lastName))
        {
            <small class="invalid-feedback d-block mb-3">Efternavn er påkrævet.</small>
        }

        <label class="form-label" for="phonenumber">Telefonnummer <span aria-hidden="true">*</span></label>
        <input id="phonenumber"
               class="form-control @(_submitted && !IsPhoneValid ? "is-invalid" : "")"
               type="tel"
               @bind="_phoneNumber"
               aria-required="true"
               aria-describedby="phone-hint"
               maxlength="20"
               placeholder="11223344 eller +45 11 22 33 44" />
        <small id="phone-hint" class="d-block text-muted @(_submitted && !IsPhoneValid ? "" : "mb-3")">
            Skriv 8 cifre (defaulter til +45), eller med landekode: +45, +47, 0045 … Mellemrum og bindestreger ignoreres.
        </small>
        @if (_submitted && !IsPhoneValid)
        {
            <small class="invalid-feedback d-block mb-3">Ugyldigt telefonnummer. Eksempler: 11223344, +45 11 22 33 44, 0045-11-22-33-44.</small>
        }

        <label class="form-label" for="email">E-mail <span aria-hidden="true">*</span></label>
        <input id="email"
               class="form-control @(_submitted && !IsEmailValid ? "is-invalid" : "mb-3")"
               type="text"
               @bind="_email"
               aria-required="true"
               placeholder="navn@eksempel.dk" />
        @if (_submitted && !IsEmailValid)
        {
            <small class="invalid-feedback d-block mb-3">Angiv en gyldig e-mailadresse.</small>
        }

        <label class="form-label" for="birthday">Fødselsdato <span aria-hidden="true">*</span></label>
        <input id="birthday"
               class="form-control @(_submitted && !IsBirthdayValid ? "is-invalid" : "mb-3")"
               type="date"
               @bind="_birthday"
               @bind:format="yyyy-MM-dd"
               aria-required="true"
               max="@TodayMax" />
        @if (_submitted && _birthday is null)
        {
            <small class="invalid-feedback d-block mb-3">Fødselsdato er påkrævet.</small>
        }
        else if (_submitted && _birthday!.Value.Date > DateTime.Today)
        {
            <small class="invalid-feedback d-block mb-3">Fødselsdato må ikke være i fremtiden.</small>
        }

        <label class="form-label" for="street">Vejnavn <span aria-hidden="true">*</span></label>
        <input id="street"
               class="form-control @(_submitted && string.IsNullOrWhiteSpace(_street) ? "is-invalid" : "mb-3")"
               type="text"
               @bind="_street"
               aria-required="true"
               placeholder="Vejnavn og husnummer" />
        @if (_submitted && string.IsNullOrWhiteSpace(_street))
        {
            <small class="invalid-feedback d-block mb-3">Vejnavn er påkrævet.</small>
        }

        <label class="form-label" for="zipcode">Postnummer <span aria-hidden="true">*</span></label>
        <input id="zipcode"
               class="form-control @(_submitted && !IsZipValid ? "is-invalid" : "mb-3")"
               type="number"
               @bind="_zipCode"
               aria-required="true"
               min="1000"
               max="9999"
               placeholder="Postnummer" />
        @if (_submitted && !IsZipValid)
        {
            <small class="invalid-feedback d-block mb-3">Postnummer skal være et gyldigt dansk postnummer (1000–9999).</small>
        }

        <label class="form-label" for="note">Helbredsnotat</label>
        <input id="note"
               class="form-control mb-3"
               type="text"
               @bind="_note"
               placeholder="Helbredsnotat (valgfrit)" />

        <PractitionerSelect Optional="true"
                            Label="Foretrukne behandler"
                            AllPractitioners="@_practitioners"
                            SelectedPractitionerId="@_selectedPractitionerId"
                            SelectedPractitionerIdChanged="OnPractitionerChanged" />

        @* type="submit" gør knappen til en indsend-knap — klik kalder formens @onsubmit.
           disabled="@_submitting" låser knappen mens serveren behandler anmodningen.
           Validering sker i stedet pr. felt når man forsøger at indsende en ufærdig formular.
           aria-busy fortæller skærmlæsere at knappen er i gang med noget (spinner). *@
        <button type="submit"
                class="btn btn-primary"
                disabled="@_submitting"
                aria-busy="@(_submitting ? "true" : "false")">
            @if (_submitting)
            {
                @* Bootstrap-spinner der vises mens serveren behandler patienten.
                   role="status" + aria-hidden="true": selve animationen skjules for
                   skærmlæsere, men teksten "Opretter patient…" nedenfor læses op. *@
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Opretter patient…</span>
            }
            else
            {
                <span>Opret Patient</span>
            }
        </button>

    </form>
}

@code {
    private bool _loading = true;
    private IReadOnlyList<PractitionerDto> _practitioners = [];
    private Guid? _selectedPractitionerId;
    private string? _firstName;
    private string? _lastName;
    private string? _phoneNumber;
    private string? _email;
    private DateTime? _birthday;
    private string? _street;
    private int? _zipCode;
    private string? _note;

    private string? _error;
    private bool _success;
    private bool _submitting;
    private bool _submitted;

    private static string TodayMax => DateTime.Today.ToString("yyyy-MM-dd");

    // Validerer E.164-format: + efterfulgt af 7–15 cifre (international standard).
    // NormalizePhone sørger for at nummeret er i dette format inden validering.
    private static readonly Regex E164Regex = new Regex(@"^\+\d{7,15}$", RegexOptions.Compiled);

    // Kræver tegn@domæne.tld — tillader de fleste gyldige e-mailadresser.
    private static readonly Regex EmailRegex = new Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", RegexOptions.Compiled);

    // Renser og normaliserer brugerens input til E.164-format (+4511223344).
    // 1. Fjerner mellemrum og bindestreger: "+45 11-22-33-44" → "+4511223344"
    // 2. Konverterer 00XX-præfiks til +XX: "004511223344" → "+4511223344"
    // 3. Tilføjer +45 som standard hvis ingen landekode: "11223344" → "+4511223344"
    private static string NormalizePhone(string raw)
    {
        var cleaned = Regex.Replace(raw.Trim(), @"[\s\-]", "");
        if (cleaned.StartsWith("00"))
            cleaned = "+" + cleaned[2..];
        if (!cleaned.StartsWith("+"))
            cleaned = "+45" + cleaned;
        return cleaned;
    }

    private bool IsPhoneValid =>
        !string.IsNullOrWhiteSpace(_phoneNumber) &&
        E164Regex.IsMatch(NormalizePhone(_phoneNumber));

    private bool IsEmailValid =>
        !string.IsNullOrWhiteSpace(_email) &&
        EmailRegex.IsMatch(_email.Trim());

    private bool IsZipValid => _zipCode is >= 1000 and <= 9999;

    private bool IsBirthdayValid => _birthday is not null && _birthday.Value.Date <= DateTime.Today;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_firstName) &&
        !string.IsNullOrWhiteSpace(_lastName) &&
        IsPhoneValid &&
        IsEmailValid &&
        IsBirthdayValid &&
        !string.IsNullOrWhiteSpace(_street) &&
        IsZipValid;

    private void OnPractitionerChanged(Guid? id)
    {
        _selectedPractitionerId = id;
        ClearMessages();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        _practitioners = await PractitionerQueries.GetAllAsync();

        _loading = false;
    }

    private async Task OnSubmit()
    {
        _submitted = true;
        if (!CanSubmit) return;

        _submitting = true;
        _error = null;
        _success = false;

        try
        {
            await CreatePatientUseCase.Execute(new CreatePatientRequest(
                _firstName!,
                _lastName!,
                _email!,
                NormalizePhone(_phoneNumber!),
                _birthday!.Value,
                _street!,
                _zipCode!.Value,
                string.IsNullOrWhiteSpace(_note) ? null : _note,
                _selectedPractitionerId ?? Guid.Empty));

            _success = true;
            ResetForm();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        catch (NotFoundException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Der opstod en uventet fejl. Prøv igen.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetForm()
    {
        _firstName = null;
        _lastName = null;
        _email = null;
        _phoneNumber = null;
        _birthday = null;
        _street = null;
        _zipCode = null;
        _note = null;
        _selectedPractitionerId = null;
        _submitted = false;
    }

    private void ClearMessages()
    {
        _error = null;
        _success = false;
    }
}
