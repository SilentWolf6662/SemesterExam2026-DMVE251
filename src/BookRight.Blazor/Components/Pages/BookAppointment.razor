@page "/opretbehandling"
@rendermode InteractiveServer
@using BookRight.Blazor.Components.Clinic
@using BookRight.Blazor.Components.Practitioner
@using BookRight.Blazor.Components.TreatmentType
@using BookRight.Domain.Exceptions
@using BookRight.Facade.Command
@using BookRight.Facade.DTO
@using BookRight.Facade.Interfaces.Queries
@using BookRight.Facade.Interfaces.UseCase

@inject IPractitionerQueries PractitionerQueries
@inject ITreatmentTypeQueries TreatmentTypeQueries
@inject IPatientQueries PatientQueries
@inject IBookAppointment BookAppointmentUseCase
@inject IBookCombinedAppointment BookCombinedUseCase

<PageTitle>Opret Booking</PageTitle>

<h2 id="booking-heading">Opret Booking</h2>

@if (_loading)
{
    <p role="status" aria-live="polite" class="text-muted">Indlæser data…</p>
}
else
{
    @* Fejl- og statusbeskeder annonceres automatisk af skærmlæsere via role *@
    <div aria-live="polite" aria-atomic="true">
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        @if (_success)
        {
            <div class="alert alert-success" role="status">Booking oprettet!</div>
        }
    </div>

    <p class="text-muted small mb-3">Felter markeret med <span aria-hidden="true">*</span> er påkrævet.</p>

    <form aria-labelledby="booking-heading" novalidate
          @onsubmit="OnSubmit" @onsubmit:preventDefault>

        <ClinicSelect SelectId="clinic"
                      SelectedClinicId="@_selectedClinicId"
                      SelectedClinicIdChanged="OnClinicChanged" />

        <fieldset>
            <legend class="fs-6 fw-semibold mb-2">1. behandling</legend>

            <PractitionerSelect SelectId="practitioner-1"
                                AllPractitioners="@_practitioners"
                                SelectedClinicId="@_selectedClinicId"
                                SelectedPractitionerId="@_selectedPractitionerId"
                                SelectedPractitionerIdChanged="OnPractitionerChanged" />

            <TreatmentTypeSelect SelectId="treatment-1"
                                 AllTreatmentTypes="@_treatmentTypes"
                                 PractitionerAuthorization="@SelectedPractitioner?.Authorization"
                                 SelectedTreatmentTypeId="@_selectedTreatmentTypeId"
                                 SelectedTreatmentTypeIdChanged="OnTreatmentTypeChanged" />

            <div class="mb-3">
                <label class="form-label" for="duration-1">
                    Varighed <span aria-hidden="true">*</span>
                </label>
                <select id="duration-1"
                        class="form-select"
                        value="@_selectedDuration"
                        @onchange="e => _selectedDuration = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value!.ToString()!)"
                        disabled="@(_selectedTreatmentTypeId is null)"
                        aria-required="true"
                        aria-describedby="duration-1-hint">
                    <option value="">-- Vælg varighed --</option>
                    @foreach (var dur in AvailableDurations)
                    {
                        <option value="@dur">@dur minutter</option>
                    }
                </select>
                <small id="duration-1-hint" class="text-muted">
                    @(_selectedTreatmentTypeId is null ? "Vælg en behandlingstype for at se varighed" : "")
                </small>
            </div>
        </fieldset>

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" id="combined-check"
                   @bind="_isCombined" @bind:after="OnCombinedToggled"
                   aria-controls="combined-section"
                   aria-expanded="@(_isCombined ? "true" : "false")" />
            <label class="form-check-label" for="combined-check">
                Kombinér med anden behandling i samme besøg
            </label>
        </div>

        @if (_isCombined)
        {
            <fieldset id="combined-section" class="border rounded p-3 mb-3">
                <legend class="fs-6 fw-semibold mb-2 w-auto px-2">2. behandling</legend>

                <PractitionerSelect SelectId="practitioner-2"
                                    AllPractitioners="@_practitioners"
                                    SelectedClinicId="@_selectedClinicId"
                                    SelectedPractitionerId="@_selectedSecondPractitionerId"
                                    SelectedPractitionerIdChanged="OnSecondPractitionerChanged" />

                <TreatmentTypeSelect SelectId="treatment-2"
                                     AllTreatmentTypes="@_treatmentTypes"
                                     PractitionerAuthorization="@SecondPractitioner?.Authorization"
                                     SelectedTreatmentTypeId="@_selectedSecondTreatmentTypeId"
                                     SelectedTreatmentTypeIdChanged="OnSecondTreatmentTypeChanged" />

                <div class="mb-3">
                    <label class="form-label" for="duration-2">
                        Varighed <span aria-hidden="true">*</span>
                    </label>
                    <select id="duration-2"
                            class="form-select"
                            value="@_selectedSecondDuration"
                            @onchange="e => _selectedSecondDuration = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value!.ToString()!)"
                            disabled="@(_selectedSecondTreatmentTypeId is null)"
                            aria-required="true"
                            aria-describedby="duration-2-hint">
                        <option value="">-- Vælg varighed --</option>
                        @foreach (var dur in AvailableSecondDurations)
                        {
                            <option value="@dur">@dur minutter</option>
                        }
                    </select>
                    <small id="duration-2-hint" class="text-muted">
                        @(_selectedSecondTreatmentTypeId is null ? "Vælg en behandlingstype for at se varighed" : "")
                    </small>
                </div>

                @* aria-live annoncerer ændringer i samlet tid når brugeren vælger varigheder *@
                <p aria-live="polite" aria-atomic="true" class="text-muted small mb-0">
                    @if (_selectedDuration.HasValue && _selectedSecondDuration.HasValue)
                    {
                        <span>
                            Samlet besøgstid: @(_selectedDuration.Value + _selectedSecondDuration.Value) minutter
                            — 2. behandling starter @(_selectedDuration.Value) min. inde i besøget.
                        </span>
                    }
                </p>
            </fieldset>
        }

        <div class="mb-3">
            <label class="form-label" for="patient-select">
                Patient <span aria-hidden="true">*</span>
            </label>
            <select id="patient-select"
                    class="form-select"
                    value="@_selectedPatientId"
                    @onchange="e => _selectedPatientId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : Guid.Parse(e.Value!.ToString()!)"
                    aria-required="true">
                <option value="">-- Vælg patient --</option>
                @foreach (var p in _patients)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label" for="date-input">
                Dato <span aria-hidden="true">*</span>
            </label>
            <input id="date-input"
                   type="date"
                   class="form-control"
                   @bind="_date"
                   @bind:format="yyyy-MM-dd"
                   min="@TodayMin"
                   aria-required="true" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="time-input">
                Starttidspunkt <span aria-hidden="true">*</span>
            </label>
            <input id="time-input"
                   type="time"
                   class="form-control @(IsStartInPast ? "is-invalid" : "")"
                   @bind="_time"
                   aria-required="true" />
            @if (IsStartInPast)
            {
                <div class="invalid-feedback">Tidspunktet er allerede passeret.</div>
            }
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@(!CanSubmit || _submitting)"
                aria-busy="@(_submitting ? "true" : "false")">
            @if (_submitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Opretter booking…</span>
            }
            else
            {
                <span>Opret Booking</span>
            }
        </button>

    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "date")] public string? PrefilledDate { get; set; }
    [SupplyParameterFromQuery(Name = "time")] public string? PrefilledTime { get; set; }

    private bool _loading = true;
    private IReadOnlyList<PractitionerDto> _practitioners = [];
    private IReadOnlyList<TreatmentTypeDto> _treatmentTypes = [];
    private IReadOnlyList<PatientDto> _patients = [];

    // Første behandling
    private Guid? _selectedClinicId;
    private Guid? _selectedPractitionerId;
    private Guid? _selectedTreatmentTypeId;
    private int? _selectedDuration;

    // Anden behandling (kombineret besøg)
    private bool _isCombined;
    private Guid? _selectedSecondPractitionerId;
    private Guid? _selectedSecondTreatmentTypeId;
    private int? _selectedSecondDuration;

    // Fælles felter
    private Guid? _selectedPatientId;
    private DateTime? _date;
    private TimeOnly? _time;

    private static string TodayMin => DateTime.Today.ToString("yyyy-MM-dd");
    private string? TimeMin => _date?.Date == DateTime.Today ? DateTime.Now.ToString("HH:mm") : null;

    private string? _error;
    private bool _success;
    private bool _submitting;

    private PractitionerDto? SelectedPractitioner =>
        _practitioners.FirstOrDefault(p => p.Id == _selectedPractitionerId);

    private PractitionerDto? SecondPractitioner =>
        _practitioners.FirstOrDefault(p => p.Id == _selectedSecondPractitionerId);

    private TreatmentTypeDto? SelectedTreatmentType =>
        _treatmentTypes.FirstOrDefault(t => t.Id == _selectedTreatmentTypeId);

    private TreatmentTypeDto? SelectedSecondTreatmentType =>
        _treatmentTypes.FirstOrDefault(t => t.Id == _selectedSecondTreatmentTypeId);

    private IReadOnlyList<int> AvailableDurations =>
        SelectedTreatmentType?.AvailableDurations ?? [];

    private IReadOnlyList<int> AvailableSecondDurations =>
        SelectedSecondTreatmentType?.AvailableDurations ?? [];

    private bool IsStartInPast =>
        _date is not null && _time.HasValue &&
        (_date.Value.Date + _time.Value.ToTimeSpan()) < DateTime.Now;

    private bool CanSubmit =>
        _selectedClinicId is not null &&
        _selectedPractitionerId is not null &&
        _selectedTreatmentTypeId is not null &&
        _selectedDuration is not null &&
        _selectedPatientId is not null &&
        _date is not null &&
        _time.HasValue &&
        !IsStartInPast &&
        (!_isCombined || (
            _selectedSecondPractitionerId is not null &&
            _selectedSecondTreatmentTypeId is not null &&
            _selectedSecondDuration is not null));

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        _practitioners = await PractitionerQueries.GetAllAsync();
        _treatmentTypes = await TreatmentTypeQueries.GetAllAsync();
        _patients = await PatientQueries.GetAllAsync();

        if (PrefilledDate is not null && DateTime.TryParse(PrefilledDate, out var d))
            _date = d;
        if (PrefilledTime is not null && TimeOnly.TryParse(PrefilledTime, out var t))
            _time = t;

        _loading = false;
    }

    private void OnClinicChanged(Guid? id)
    {
        _selectedClinicId = id;
        _selectedPractitionerId = null;
        _selectedTreatmentTypeId = null;
        _selectedDuration = null;
        _selectedSecondPractitionerId = null;
        _selectedSecondTreatmentTypeId = null;
        _selectedSecondDuration = null;
        ClearMessages();
    }

    private void OnPractitionerChanged(Guid? id)
    {
        _selectedPractitionerId = id;
        _selectedTreatmentTypeId = null;
        _selectedDuration = null;
        ClearMessages();
    }

    private void OnTreatmentTypeChanged(Guid? id)
    {
        _selectedTreatmentTypeId = id;
        _selectedDuration = null;
        ClearMessages();

        if (SelectedTreatmentType?.AvailableDurations.Count == 1)
            _selectedDuration = SelectedTreatmentType.AvailableDurations[0];
    }

    private void OnSecondPractitionerChanged(Guid? id)
    {
        _selectedSecondPractitionerId = id;
        _selectedSecondTreatmentTypeId = null;
        _selectedSecondDuration = null;
        ClearMessages();
    }

    private void OnSecondTreatmentTypeChanged(Guid? id)
    {
        _selectedSecondTreatmentTypeId = id;
        _selectedSecondDuration = null;
        ClearMessages();

        if (SelectedSecondTreatmentType?.AvailableDurations.Count == 1)
            _selectedSecondDuration = SelectedSecondTreatmentType.AvailableDurations[0];
    }

    private void OnCombinedToggled()
    {
        if (!_isCombined)
        {
            _selectedSecondPractitionerId = null;
            _selectedSecondTreatmentTypeId = null;
            _selectedSecondDuration = null;
        }
        ClearMessages();
    }

    private async Task OnSubmit()
    {
        if (!CanSubmit) return;

        _submitting = true;
        _error = null;
        _success = false;

        try
        {
            var from = _date!.Value.Date + _time!.Value.ToTimeSpan();

            if (_isCombined)
            {
                await BookCombinedUseCase.Execute(new BookCombinedAppointmentRequest(
                    from,
                    _selectedPatientId!.Value,
                    _selectedPractitionerId!.Value,
                    _selectedTreatmentTypeId!.Value,
                    _selectedDuration!.Value,
                    _selectedSecondPractitionerId!.Value,
                    _selectedSecondTreatmentTypeId!.Value,
                    _selectedSecondDuration!.Value));
            }
            else
            {
                var to = from.AddMinutes(_selectedDuration!.Value);
                await BookAppointmentUseCase.Execute(new BookAppointmentRequest(
                    from,
                    to,
                    _selectedDuration!.Value,
                    _selectedTreatmentTypeId!.Value,
                    _selectedPatientId!.Value,
                    _selectedPractitionerId!.Value));
            }

            _success = true;
            ResetForm();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        catch (NotFoundException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Der opstod en uventet fejl. Prøv igen.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetForm()
    {
        _selectedClinicId = null;
        _selectedPractitionerId = null;
        _selectedTreatmentTypeId = null;
        _selectedDuration = null;
        _isCombined = false;
        _selectedSecondPractitionerId = null;
        _selectedSecondTreatmentTypeId = null;
        _selectedSecondDuration = null;
        _selectedPatientId = null;
        _date = null;
        _time = null;
    }

    private void ClearMessages()
    {
        _error = null;
        _success = false;
    }
}
