@using BookRight.Facade.DTO

@* ── Ydre wrapper ────────────────────────────────────────────────────────────
   <section> er et semantisk HTML5-landmark-element der grupperer relateret indhold.
   overflow-auto gør at tabellen kan scrolles vandret på små skærme frem for at
   bryde layoutet. aria-label="Kalender" navngiver sektionen for skærmlæsere.
*@
<section class="calendar-grid-wrapper overflow-auto" aria-label="Kalender">

    @* ── Kalender-tabel ──────────────────────────────────────────────────────
       En HTML-tabel er det rigtige valg her fordi data er todimensionalt:
       rækker = timer, kolonner = ugedage.
    *@
    <table class="calendar-table table table-bordered mb-0">

        @* <caption> beskriver tabellens indhold for skærmlæsere.
           visually-hidden skjuler den visuelt da overskriften allerede
           er synlig i CalendarToolbar. *@
        <caption class="visually-hidden">
            Kalender @WeekDays.First().ToString("dd. MMM") – @WeekDays.Last().ToString("dd. MMM yyyy")
        </caption>

        @* ── Tabeloverskrift ─────────────────────────────────────────────────
           <thead> indeholder kolonneoverskrifterne (ugedage).
           Den første <th> er tom og reserverer pladsen til tidskolonnen til venstre.
        *@
        <thead class="table-light">
            <tr>
                <th class="calendar-time-col"><span class="visually-hidden">Tid</span></th>

                @* @foreach løber igennem alle 7 ugedage og opretter én <th> pr. dag.
                   Hvis dagen er i dag, tilføjes Bootstrap-klassen "table-primary"
                   som fremhæver kolonnen med blå baggrund. *@
                @foreach (var day in WeekDays)
                {
                    <th class="text-center @(day.Date == DateTime.Today.Date ? "table-primary" : "")">
                        @* <abbr> viser en forkortelse (f.eks. "Man") og title-attributten
                           giver det fulde navn (f.eks. "Mandag") ved hover og til skærmlæsere. *@
                        <abbr title="@day.ToString("dddd")">@day.ToString("ddd")</abbr>

                        @* <time> med datetime i ISO-format er semantisk korrekt for datoer *@
                        <time datetime="@day.ToString("yyyy-MM-dd")" class="fw-bold d-block">@day.ToString("dd/MM")</time>
                    </th>
                }
            </tr>
        </thead>

        @* ── Tabelkrop ───────────────────────────────────────────────────────
           <tbody> indeholder én række pr. time i åbningstiden.
           Det ydre @for-loop itererer over timer (f.eks. 8, 9, 10 … 17).
           Det indre @foreach itererer over ugedage og skaber én celle pr. kombination.
        *@
        <tbody>
            @for (int hour = StartHour; hour < EndHour; hour++)
            {
                @* Hver række har en fast højde så gitteret ser ensartet ud
                   uanset om der er aftaler i tidsslottet eller ej. *@
                <tr style="height:48px">

                    @* Tidskolonnen til venstre viser timen som "08:00", "09:00" osv. *@
                    <td class="calendar-time-col text-muted small align-top pe-2">
                        <time datetime="@(hour.ToString("00")):00">@hour.ToString("00"):00</time>
                    </td>

                    @* For hver dag oprettes en celle der indeholder de aftaler
                       der starter på præcis denne dag og time. *@
                    @foreach (var day in WeekDays)
                    {
                        var slots = GetAppointmentsForSlot(day, hour);

                        @* position-relative er nødvendigt fordi CalenderItem
                           bruger absolut positionering indeni cellen. *@
                        <td class="calendar-cell p-0 align-top position-relative">

                            @* For hver aftale i dette tidsslot renderes en CalenderItem-komponent
                               der viser aftalen som en farvet knap man kan klikke på. *@
                            @foreach (var apt in slots)
                            {
                                <CalenderItem Appointment="apt" PractitionerName="@GetPractitionerName(apt.PractitionerId)" OnStatusChanged="OnStatusChanged" />
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    [Parameter, EditorRequired] public IEnumerable<DateTime> WeekDays { get; set; } = [];
    [Parameter, EditorRequired] public int StartHour { get; set; }
    [Parameter, EditorRequired] public int EndHour { get; set; }
    [Parameter, EditorRequired] public IEnumerable<AppointmentDto> Appointments { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<PractitionerDto> Practitioners { get; set; } = [];
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    // Matcher kun på dato og starttimen – aftaler der spænder over flere timer vises kun i startslottet
    private IEnumerable<AppointmentDto> GetAppointmentsForSlot(DateTime day, int hour) => Appointments.Where(a => a.Start.Date == day.Date && a.Start.Hour == hour);

    private string GetPractitionerName(Guid id)
    {
        // Practitioners er allerede indlæst af CalenderView, så ingen ekstra database-forespørgsel her
        var p = Practitioners.FirstOrDefault(x => x.Id == id);
        return p is null ? "Ukendt" : $"{p.FirstName} {p.LastName}";
    }
}
