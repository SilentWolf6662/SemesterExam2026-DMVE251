@using BookRight.Facade.DTO
@using BookRight.Facade.Interfaces.Queries
@inject IAppointmentQueries AppointmentQueries
@inject IPractitionerQueries PractitionerQueries

<div class="calendar-toolbar mb-3 d-flex align-items-center gap-3">
    <button class="btn btn-outline-dark btn-sm" @onclick="PreviousWeek">&lsaquo; Forrige</button>
    <span class="fw-semibold">@_weekStart.ToString("dd. MMM") &ndash; @WeekEnd.ToString("dd. MMM yyyy")</span>
    <button class="btn btn-outline-dark btn-sm" @onclick="NextWeek">Næste &rsaquo;</button>
    <button class="btn btn-outline-primary btn-sm ms-2" @onclick="GoToToday">I dag</button>

    <select class="form-select form-select-sm ms-auto" style="max-width:220px"
            @bind="SelectedPractitionerId">
        <option value="">— Alle behandlere —</option>
        @foreach (var practitioner in _practitioners)
        {
            <option value="@practitioner.Id">@practitioner.FirstName @practitioner.LastName</option>
        }
    </select>
</div>

@if (_loading)
{
    <p class="text-muted">Indlæser kalender…</p>
}
else
{
    <div class="calendar-grid-wrapper overflow-auto">
        <table class="calendar-table table table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th class="calendar-time-col"></th>
                    @foreach (var day in WeekDays)
                    {
                        <th class="text-center @(day.Date == DateTime.Today.Date ? "table-primary" : "")">
                            <div>@day.ToString("ddd")</div>
                            <div class="fw-bold">@day.ToString("dd/MM")</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = StartHour; hour < EndHour; hour++)
                {
                    <tr style="height:48px">
                        <td class="calendar-time-col text-muted small align-top pe-2">@hour.ToString("00"):00</td>
                        @foreach (var day in WeekDays)
                        {
                            var appointmentSlots = GetAppointmentsForSlot(day, hour);
                            <td class="calendar-cell p-0 align-top position-relative">
                                @foreach (var apt in appointmentSlots)
                                {
                                    <div class="calendar-apt @GetStatusClass(apt.Status)"
                                         title="@FormatTooltip(apt)">
                                        <span class="small fw-semibold">@apt.Start.ToString("HH:mm")–@apt.End.ToString("HH:mm")</span>
                                        <br />
                                        <span class="small">@GetPractitionerName(apt.PractitionerId)</span>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int StartHour = 8;
    private const int EndHour = 18;

    private bool _loading = true;
    private IReadOnlyList<AppointmentDto> _allAppointments = [];
    private IReadOnlyList<PractitionerDto> _practitioners = [];
    private DateTime _weekStart = GetMonday(DateTime.Today);

    private string _selectedPractitionerId = "";
    private string SelectedPractitionerId
    {
        get => _selectedPractitionerId;
        set { _selectedPractitionerId = value; StateHasChanged(); }
    }

    private DateTime WeekEnd => _weekStart.AddDays(6);
    private IEnumerable<DateTime> WeekDays => Enumerable.Range(0, 7).Select(i => _weekStart.AddDays(i));

    protected override async Task OnInitializedAsync()
    {
        var appointments = await AppointmentQueries.GetAllAsync();
        var practitioners = await PractitionerQueries.GetAllAsync();
        _allAppointments = appointments;
        _practitioners = practitioners;
        _loading = false;
    }

    private IEnumerable<AppointmentDto> FilteredAppointments =>
        string.IsNullOrEmpty(SelectedPractitionerId)
            ? _allAppointments
            : _allAppointments.Where(a => a.PractitionerId.ToString() == SelectedPractitionerId);

    private IEnumerable<AppointmentDto> GetAppointmentsForSlot(DateTime day, int hour)
    {
        return FilteredAppointments.Where(a => a.Start.Date == day.Date && a.Start.Hour == hour);
    }

    private static string GetStatusClass(string status) => status.ToLower() switch
    {
        "booked"    => "apt-booked",
        "completed" => "apt-completed",
        "cancelled" => "apt-cancelled",
        "noshow"    => "apt-noshow",
        _           => "apt-booked"
    };

    private string GetPractitionerName(Guid id)
    {
        var p = _practitioners.FirstOrDefault(x => x.Id == id);
        return p is null ? "Ukendt" : $"{p.FirstName} {p.LastName}";
    }

    private string FormatTooltip(AppointmentDto apt)
    {
        return $"{apt.Start:HH:mm}–{apt.End:HH:mm} | {GetPractitionerName(apt.PractitionerId)} | {apt.Status}";
    }

    private void PreviousWeek() => _weekStart = _weekStart.AddDays(-7);
    private void NextWeek() => _weekStart = _weekStart.AddDays(7);
    private void GoToToday() => _weekStart = GetMonday(DateTime.Today);

    private static DateTime GetMonday(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }
}
