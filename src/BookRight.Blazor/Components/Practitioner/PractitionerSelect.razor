@using BookRight.Facade.DTO

<div class="mb-3">
    <label class="form-label" for="@SelectId">
        Behandler <span aria-hidden="true">*</span>
    </label>
    <select id="@SelectId"
            class="form-select"
            value="@SelectedPractitionerId"
            @onchange="OnChanged"
            disabled="@(SelectedClinicId is null)"
            aria-required="true"
            aria-describedby="@HintId">
        <option value="">-- Vælg behandler --</option>
        @foreach (var p in Filtered)
        {
            <option value="@p.Id">@p.FirstName @p.LastName (@TranslatedAuthorizationName(p.Authorization))</option>
        }
    </select>
    <small id="@HintId" class="text-muted">
        @(SelectedClinicId is null ? "Vælg en klinik for at se tilgængelige behandlere" : "")
    </small>
</div>

@code {
    [Parameter] public string SelectId { get; set; } = "practitioner-select";
    [Parameter, EditorRequired] public IReadOnlyList<PractitionerDto> AllPractitioners { get; set; } = [];
    [Parameter] public Guid? SelectedClinicId { get; set; }
    [Parameter] public Guid? SelectedPractitionerId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedPractitionerIdChanged { get; set; }

    private string HintId => $"{SelectId}-hint";

    private IEnumerable<PractitionerDto> Filtered =>
        SelectedClinicId is null
            ? []
            : AllPractitioners.Where(p => p.ClinicIds.Contains(SelectedClinicId.Value));

    private async Task OnChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        var id = string.IsNullOrEmpty(val) ? (Guid?)null : Guid.Parse(val);
        await SelectedPractitionerIdChanged.InvokeAsync(id);
    }

    private static string TranslatedAuthorizationName(string authorization) => authorization switch
    {
        "Physiotherapist" => "Fysioterapeut",
        "Masseur"         => "Massør",
        "Acupuncturist"   => "Akupunktør",
        "Dietician"       => "Kostvejleder",
        _                 => authorization
    };
}
